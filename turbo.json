{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".npmrc",
    ".github/actions/setup-bun/**",
    ".github/workflows/check-test.yml",
    "package.json"
  ],
  "globalEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "typecheck:tsc": {
      "dependsOn": ["transit"]
    },
    "@opencode/cli#typecheck:tsc": {
      "dependsOn": ["transit", "@opencode/core#typecheck:tsc"]
    },
    "@opencode/sdk#typecheck:tsc": {
      "dependsOn": ["transit", "@opencode/core#typecheck:tsc"]
    },
    "@opencode/server#typecheck:tsc": {
      "dependsOn": ["transit", "@opencode/core#typecheck:tsc"]
    },
    "@opencode/simulation#typecheck:tsc": {
      "dependsOn": ["transit", "@opencode/core#typecheck:tsc"]
    },
    "@opencode/tui#typecheck:tsc": {
      "dependsOn": ["transit", "@opencode/core#typecheck:tsc"]
    },
    "test:components": {
      "outputs": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@opencode/desktop#test": {
      "outputs": [],
      "cache": false
    },
    "@opencode/sdk#verify:package": {
      "outputs": []
    }
  }
}
